{
  "name": "ice-cream-man-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": { "install": { "exclude": ["@react-navigation/bottom-tabs", "@react-navigation/native"] } },
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:metro\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:metro": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port ${EXPO_PORT:-8081}",
    "build": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "verify:deps": "node scripts/verify-pnpm-overrides.cjs",
    "verify:android-release": "node scripts/verify-android-release.cjs",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "qr": "node scripts/generate_qr.mjs",
    "postinstall": "node scripts/patch-brace-expansion-cjs.cjs",
    "eas-build-pre-install": "node scripts/verify-pnpm-overrides.cjs && node scripts/ensure-brace-expansion.cjs",
    "eas-build-post-install": "node scripts/ensure-brace-expansion.cjs && node scripts/patch-brace-expansion-cjs.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3", "@react-native-async-storage/async-storage": "2.2.0", "@react-navigation/bottom-tabs": "^7.18.12", "@react-navigation/elements": "^2.9.2", "@react-navigation/native": "^7.3.12", "@tanstack/react-query": "^5.90.12", "@trpc/client": "11.8.0", "@trpc/react-query": "11.8.0", "@trpc/server": "11.8.0", "axios": "^1.18.1", "brace-expansion": "2.1.4", "clsx": "^2.1.1", "cookie": "^1.1.1", "dotenv": "^16.6.1", "drizzle-orm": "^0.45.2", "expo": "~54.0.34", "expo-asset": "~12.0.13", "expo-audio": "~1.1.1", "expo-build-properties": "~1.0.10", "expo-constants": "~18.0.13", "expo-font": "~14.0.12", "expo-haptics": "~15.0.8", "expo-iap": "^5.0.0", "expo-image": "~3.0.11", "expo-keep-awake": "~15.0.8", "expo-linear-gradient": "~15.0.8", "expo-linking": "~8.0.12", "expo-location": "~19.0.8", "expo-notifications": "~0.32.17", "expo-router": "~6.0.24", "expo-secure-store": "~15.0.8", "expo-splash-screen": "~31.0.13", "expo-status-bar": "~3.0.9", "expo-symbols": "~1.0.8", "expo-system-ui": "~6.0.9", "expo-updates": "^29.0.19", "expo-video": "~3.0.16", "expo-web-browser": "~15.0.11", "express": "^4.22.1", "googleapis": "^174.0.1", "helmet": "^8.3.0", "jose": "6.1.0", "nativewind": "^4.2.1", "postgres": "^3.4.9", "react": "19.1.0", "react-dom": "19.1.0", "react-native": "0.81.5", "react-native-gesture-handler": "~2.28.0", "react-native-reanimated": "~4.1.1", "react-native-safe-area-context": "~5.6.0", "react-native-screens": "~4.16.0", "react-native-svg": "15.12.1", "react-native-web": "~0.21.0", "react-native-worklets": "0.5.1", "sanitize-html": "^2.17.6", "superjson": "^1.13.3", "tailwind-merge": "^2.6.1", "zod": "^4.2.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3", "@types/cookie": "^0.6.0", "@types/express": "^4.17.25", "@types/node": "^22.19.3", "@types/qrcode": "^1.5.6", "@types/react": "~19.1.10", "@types/sanitize-html": "^2.16.1", "concurrently": "^9.2.1", "cross-env": "^7.0.3", "drizzle-kit": "^0.31.8", "esbuild": "^0.28.0", "eslint": "^9.39.2", "eslint-config-expo": "~10.0.0", "prettier": "^3.7.4", "qrcode": "^1.5.4", "tailwindcss": "^3.4.17", "tsx": "^4.21.0", "typescript": "~5.9.3", "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@9.12.0",
  "overrides": { "brace-expansion": "2.1.4", "fast-uri": "3.1.5", "js-yaml": "4.3.1", "nanoid": "3.3.18", "postcss": "8.5.23", "undici": "6.28.0" },
  "pnpm": { "overrides": { "axios": "^1.18.1", "@xmldom/xmldom": "^0.9.8", "ajv": "^8.17.1", "@eslint/eslintrc>ajv": "6.12.6", "eslint>ajv": "6.12.6", "brace-expansion": "2.1.4", "brace-expansion@>=2.1.0 <3": "2.1.4", "brace-expansion@>=5": "2.1.4", "esbuild": "^0.28.1", "fast-uri": "3.1.5", "flatted": "^3.4.2", "form-data": "^4.0.4", "js-yaml": "4.3.1", "nanoid": "3.3.18", "node-forge": "^1.3.1", "path-to-regexp": "^8.2.0", "picomatch": "^4.0.3", "postcss": "8.5.23", "qs": "^6.14.1", "rollup": "^4.59.0", "shell-quote": "^1.8.3", "tar": "^7.5.21", "undici": "6.28.0", "uuid": "^11.1.1" } }
}
